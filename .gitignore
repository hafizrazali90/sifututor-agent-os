# Ignore everything by default. This umbrella repo tracks only the shared
# Claude/Codex workflow layer, not product repositories or local machine state.
*

# Track root workflow files.
!.gitignore
!README.md
!AGENTS.md

# Track shared playbooks and reference documents (decks, sourcebooks,
# research, handoffs) so the team can refer to them for future projects.
!docs/
!docs/**
# Partner-supplied commercial material stays local.
docs/ai-classroom-concept/partner/
# Third-party source documents (copyright, size) and archives stay local.
docs/ai-classroom-concept/sources/*.pdf
docs/**/*.zip
# Rendered screenshot evidence is reproducible from the sources.
docs/**/screenshots/
docs/**/rendered/

# Track shared guard scripts.
!scripts/
scripts/*
!scripts/agent-checks/
!scripts/agent-checks/**
!scripts/agent-access/
!scripts/agent-access/**

# Track repo-local Codex skills that wrap shared playbooks.
!.agents/
.agents/*
!.agents/skills/
!.agents/skills/**
!.agents/plugins/
!.agents/plugins/**

# Track private local Codex plugin scaffolds.
!plugins/
plugins/*
!plugins/sifututor-workflow/
!plugins/sifututor-workflow/**

# Track repo-local Codex hook configuration.
!.codex/
.codex/*
!.codex/config.toml

# Always ignore local/system files even if future patterns change.
.DS_Store
.claude/
!.claude/
.claude/*
!.claude/commands/
.claude/commands/*
!.claude/commands/monitor-production-logs.md
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/*.py
.mcp.json
.pytest_cache/
__pycache__/
*.pyc
live/
.workflow-rollout/

# Product repos stay independent nested Git repositories.
creative-hub/
finch-inbox/
kelas/
lls/
lls-frontend/
lls-mobile/
ripple-suite/
sifu-tutor/
sifututor_parent/
sifututor_tutor/
team-inbox/
docs/**/* 2/
