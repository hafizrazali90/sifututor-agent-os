# Ignore everything by default. This umbrella repo tracks only the shared
# Claude/Codex workflow layer, not product repositories or local machine state.
*

# Track root workflow files.
!.gitignore
!README.md
!AGENTS.md

# Track workspace documents (playbooks, product/QA references, staff guides,
# analytics packets, partnership decks) so the team can refer to them.
!docs/
!docs/**

# Client and programme packages live in Learnest-Lab/papertrail, not here.
# See docs/README.md.
docs/ai-classroom-concept/
docs/tekun-collection-*
docs/sifututor-ecosystem-*
docs/sourcebook-assets/
docs/kesuma-ecosystem-research-*

# Rebuildable output: regenerate from the tracked sources instead.
docs/**/screenshots/
docs/**/rendered/
docs/**/*.zip
docs/**/* 2/

# Track shared guard scripts.
!scripts/
scripts/*
!scripts/agent-checks/
!scripts/agent-checks/**
!scripts/agent-access/
!scripts/agent-access/**

# Track repo-local Codex skills that wrap shared playbooks.
!.agents/
.agents/*
!.agents/skills/
!.agents/skills/**
!.agents/plugins/
!.agents/plugins/**

# Track private local Codex plugin scaffolds.
!plugins/
plugins/*
!plugins/sifututor-workflow/
!plugins/sifututor-workflow/**

# Track repo-local Codex hook configuration.
!.codex/
.codex/*
!.codex/config.toml

# Track the repo-local Kilo Code Agent OS adapter.
!.kilo/
.kilo/*
!.kilo/agents/
!.kilo/agents/sifututor-agent-os.md

# Always ignore local/system files even if future patterns change.
.DS_Store
.claude/
!.claude/
.claude/*
!.claude/commands/
.claude/commands/*
!.claude/commands/monitor-production-logs.md
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/*.py
!.claude/hooks/*.sh
!.claude/hooks/*.ps1
.mcp.json
.pytest_cache/
__pycache__/
*.pyc
live/
.workflow-rollout/

# Product repos stay independent nested Git repositories.
creative-hub/
finch-inbox/
kelas/
lls/
lls-frontend/
lls-mobile/
ripple-suite/
sifu-tutor/
sifututor_parent/
sifututor_tutor/
team-inbox/
