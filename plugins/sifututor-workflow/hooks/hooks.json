{
  "SessionStart": [
    {
      "matcher": "^(startup|resume|clear|compact)$",
      "hooks": [
        {
          "type": "command",
          "command": "python3 /Users/hafizrazali/Projects/Sifututor/scripts/agent-checks/codex-lifecycle-hook.py",
          "timeout": 10,
          "statusMessage": "Loading Sifututor workflow plugin context"
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "python3 /Users/hafizrazali/Projects/Sifututor/scripts/agent-checks/codex-lifecycle-hook.py",
          "timeout": 10,
          "statusMessage": "Dispatching Sifututor workflow skill"
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "^Bash$",
      "hooks": [
        {
          "type": "command",
          "command": "python3 /Users/hafizrazali/Projects/Sifututor/scripts/agent-checks/codex-pre-tool-use.py",
          "timeout": 30,
          "statusMessage": "Checking Sifututor Bash guardrails"
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "^Bash$",
      "hooks": [
        {
          "type": "command",
          "command": "python3 /Users/hafizrazali/Projects/Sifututor/scripts/agent-checks/codex-post-tool-use.py",
          "timeout": 10,
          "statusMessage": "Recording Sifututor Bash result"
        }
      ]
    }
  ]
}
